"""
Problem: Two Sum (Sorted Array)
Link: https://www.hellointerview.com/learn/code/two-pointers/two-sum
Date: 2026-11-13 | Solved alone? Yes + hint about using two pointers (should've been obvious lol)
Pattern: two-pointers
Key insight: When the pair_sum is less than the target, 
             we move the left pointer because it's a sorted array, 
             if the sume of the largest value (right pointer) and 
             the smallest value (left pointer)falls short of the target and 
             it can't be paired with anything to make the target value
             we move right of the smallest values (left pointer) to the next bigger 
             value and check if the sum of the pair is equal to the target 
Time: O(n)
Space: O(1)
Revisit: 
Miss: In the first solution didn't use two pointer used hash set, missed the sorted array clue

"""
nums = [1,3,4,6,8,10,13]
target = 13


def getPair(nums, target):
    seen = set()
    for x in nums:
        rem = target - x
        if rem in seen:
            return True
        seen.add(x)
    return False

# print(getPair([1,3,4,6,8,10,13], 13))
# print(getPair([1,3,4,6,8,10,13], 0))
# print(getPair([1,3,4,6,8,10,13], 6))
# print(getPair([], 6))


def getPairTwoPointers(nums, target):
    left, right = 0, len(nums)-1
    while left < right:
        pair_sum = nums[left] + nums[right]
        if pair_sum == target:
            return True
        if pair_sum < target:
            left+=1
        else:
            right-=1
    return False


print(getPairTwoPointers([1,3,4,6,8,10,13], 13))
print(getPairTwoPointers([1,3,4,6,8,10,13], 0))
print(getPairTwoPointers([1,3,4,6,8,10,13], 6))
print(getPairTwoPointers([1], 6))